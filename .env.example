# Copy to `.env` next to the compose file and fill in. Never commit the filled copy.

# --- database ---------------------------------------------------------------
# Set when the roles were created by deploy/provision-messenger-db.sql. The client
# owns the schema and applies the migrations; the MCP role only ever reads it.
MESSENGER_INGEST_DB_PASSWORD=
MESSENGER_MCP_DB_PASSWORD=

# --- account ----------------------------------------------------------------
# A label for this account, stored on every row so a second account could be added
# later without merging corpora. Any short string.
MESSENGER_ACCOUNT=

# The Messenger login and the encrypted device are not here: messenger-ingest keeps
# both in the database's private schemas.
